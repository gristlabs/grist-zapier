# See README.md, "The flavor switch", for how these fit together. The push
# and validate npm scripts read this file (Node's built-in .env loader).

# "oauth" or "apikey". The push:/validate: scripts set this for you.
GRIST_ZAPIER_AUTH=

# Building your own OAuth integration bound to a self-hosted Grist? Point the
# push at your Zapier app instead of the ids in apps.json. Get these from
# `zapier-platform register` (they land in .zapierapprc).
ZAPIER_APP_ID=
ZAPIER_APP_KEY=

# OAuth flavor: set these on the Zapier version with `env:set` (see README),
# not from this file — they are read at runtime on Zapier. The Grist server
# this integration is bound to, and the OAuth client it connects as,
# registered on that server.
GRIST_HOST=
CLIENT_ID=
CLIENT_SECRET=

# For running tests against a local Grist instance.
TEST_GRIST_API_KEY=
TEST_GRIST_DOC_ID=
