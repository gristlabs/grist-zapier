# See README.md, "The flavor switch", for how these fit together.

# "oauth" or "apikey".
GRIST_ZAPIER_AUTH=

# OAuth flavor only: the Grist server this integration is bound to, and the
# OAuth client it connects as, registered on that server.
GRIST_HOST=
CLIENT_ID=
CLIENT_SECRET=

# For running tests against a local Grist instance.
TEST_GRIST_API_KEY=
TEST_GRIST_DOC_ID=
