{
  "name": "grist",
  "version": "2.0.0",
  "description": "Grist is a modern spreadsheet-database and app platform.",
  "main": "index.js",
  "scripts": {
    "start:grist": "docker run --rm --name grist-for-zapier -v $PWD/fixtures:/persist -p 8080:8484 -e ALLOWED_WEBHOOK_DOMAINS=* -it gristlabs/grist",
    "test": "TEST_GRIST_API_KEY=d36010f168a08018434807a34d1f43eb9b0d1de3 TEST_GRIST_DOC_ID=12Ah5NX72AnycZHEmq491Q GRIST_ZAPIER_AUTH=apikey jest --testTimeout 10000",
    "validate": "npm run validate:oauth && npm run validate:apikey",
    "validate:oauth": "GRIST_ZAPIER_AUTH=oauth zapier-platform validate",
    "validate:apikey": "GRIST_ZAPIER_AUTH=apikey zapier-platform validate",
    "push": "node scripts/select-app && zapier-platform push && node scripts/ensure-env",
    "push:oauth": "GRIST_ZAPIER_AUTH=oauth npm run push",
    "push:apikey": "GRIST_ZAPIER_AUTH=apikey npm run push",
    "zapier-platform:oauth": "GRIST_ZAPIER_AUTH=oauth node scripts/select-app && zapier-platform",
    "zapier-platform:apikey": "GRIST_ZAPIER_AUTH=apikey node scripts/select-app && zapier-platform"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "zapier-platform-core": "19.0.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nock": "^14.0.15",
    "zapier-platform-cli": "^19.0.0"
  },
  "private": true,
  "zapier": {
    "convertedByCLIVersion": "19.0.0"
  }
}
